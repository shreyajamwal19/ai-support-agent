# Optional: only needed to exercise the LLM generation/judge paths.
# The default pipeline (rule-based intent, TF-IDF retrieval, extractive generation) runs
# with no API key at all.
#
# Provider selection (see src/llm/provider.py). Exactly ONE provider is used per run --
# there is no automatic fallback. Set LLM_PROVIDER to switch; the fallback providers
# (openai, groq) are for development/recovery only unless you explicitly choose one for
# an entire benchmark run.
LLM_PROVIDER=gemini
# LLM_MODEL=            # optional override of the provider's default model

GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
